# then we load the SRA environment and changed the directory where the .txt file was moved.
[debasmita@node01 ~]$ module load anaconda3/2024.06
(base) [debasmita@node01 ~]$ conda activate sra_env
(sra_env) [debasmita@node01 SRA]$ prefetch --version
(sra_env) [debasmita@node01 ~]$ cd /home/debasmita/workspace/Canidae_Felidae_Project/results/FEL001/SRA/




# Wanted to check which accession numbers are available in the file.
(sra_env) [debasmita@node01 ~]$ cat /home/debasmita/workspace/Canidae_Felidae_Project/results/FEL001/SRA/FEL001_SRA.txt



# Download each SRA files from taking the accession number from the .txt file 
# This takes hours - the laptop sceen should not go to sleep

while read -r accession; do
    echo "Processing: $accession"
    prefetch "$accession" --output-directory "$accession"
done < FEL001_SRA.txt



# Now perfect fetch has saved the files one folder deeper.
(sra_env) [debasmita@node01 SRA]$ find SRR12354115 -type f



# Then we check which of them are downloaded.
(sra_env) [debasmita@node01 SRA]$ ls -lh /home/debasmita/workspace/Canidae_Felidae_Project/results/FEL001/SRA



# Check wether the downloaded files are empty.
for accession in $(cat FEL001_SRA.txt); do
    if [ -s "$accession/$accession/$accession.sra" ]; then
        echo "FOUND: $accession"
    else
        echo "MISSING OR EMPTY: $accession"
    fi
done



# Check the readability of each doenloaded file
for accession in $(cat FEL001_SRA.txt); do
    echo "Validating: $accession"
    vdb-validate "$accession/$accession/$accession.sra"
done


# Then we made a folder for output
(sra_env) [debasmita@node01 SRA]$ mkdir -p /home/debasmita/workspace/Canidae_Felidae_Project/results/FEL001/FASTQ



# Convert the downloaded SRA files in FASTQ files 
# This can take long time
cd /home/debasmita/workspace/Canidae_Felidae_Project/results/FEL001

while read -r accession; do
    echo "Converting: $accession"

    fasterq-dump "SRA/$accession/$accession/$accession.sra" \
        --outdir FASTQ \
        --threads 4

done < SRA/FEL001_SRA.txt




# Check whether all of the files are on output directory
(sra_env) [debasmita@node01 FEL001]$ ls -lh FASTQ/*.fastq


# Check the number of files in output directory
(sra_env) [debasmita@node01 FEL001]$ ls FASTQ/*.fastq | wc -l


# Check whether fastqc is available, If it is, then it will show the path.
(sra_env) [debasmita@node01 FEL001]$ which fastqc


# FastQC processes FASTQ files 
(sra_env) [debasmita@node01 FEL001]$ fastqc FASTQ/*.fastq --outdir=FASTQ --threads 4


# Counts the HTML reports generated by FastQC.
(sra_env) [debasmita@node01 FEL001]$ ls FASTQ/*_fastqc.html | wc -l


# Check the MultiQC is installed - If it gives a pathway, then it is installed.
(sra_env) [debasmita@node01 FEL001]$ which multiqc



# Generate the combined quality report.
