from collections import defaultdict

files = sorted(glob.glob("FASTQ/trimmed/SRR*.truncated.gz"))
seen = defaultdict(set)

print("Sample\tReads_checked\tUnique_sequences\tDuplicate_fraction")

for path in files:
    sample = os.path.basename(path).replace(".truncated.gz", "")
    total = 0
    unique = set()

    with gzip.open(path, "rt") as f:
        while True:
            header = f.readline()
            if not header:
                break
            seq = f.readline().strip()
            f.readline()
            f.readline()
            if seq:
                unique.add(seq)
                total += 1

    print(f"{sample}\t{total}\t{len(unique)}\t{1-len(unique)/total:.4f}")
    seen[sample] = unique

print("\nPairwise exact sequence overlap:")
for i, a in enumerate(files):
    sa = os.path.basename(a).replace(".truncated.gz", "")
    for b in files[i+1:]:
        sb = os.path.basename(b).replace(".truncated.gz", "")
        overlap = len(seen[sa] & seen[sb])
        if overlap:
            print(f"{sa}\t{sb}\t{overlap}")
