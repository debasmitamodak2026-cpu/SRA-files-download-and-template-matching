# Now to automate the fastq conversion and zipping those files for rest of the 7 sra files for felids
# (as we started downloading 8 sra files for felids)
# we used this code
# The script will:
# 1. Process each accession sequentially.
# 2. Convert the .sra file using fasterq-dump.
# 3. Compress both FASTQ files using gzip.
# 4. Verify the compressed files.
# 5. Record success or failure in a status log.
# 6. Skip accessions that have already been successfully converted and compressed.
# 7. Continue to the next accession even if one fails.




$$$$$$$$$$$$$$$$$$$$$$

cat > /home/debasmita/workspace/Canidae_Felidae_Project/felids/sra/sra_downloads/convert_remaining_felids.sh <<'EOF'
#!/usr/bin/env bash

set -u

# Load software
module load anaconda3/2024.06
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sra_tools

# Directories
BASE="/home/debasmita/workspace/Canidae_Felidae_Project/felids/sra/sra_downloads"
SRA_DIR="$BASE/sra_files"
RAW_DIR="$BASE/fastq_raw_new"
TMP_DIR="$BASE/fasterq_tmp"
WORK_DIR="$BASE/conversion_work"

mkdir -p "$RAW_DIR" "$TMP_DIR" "$WORK_DIR"
chmod 700 "$TMP_DIR"

export TMPDIR="$TMP_DIR"

# Remaining seven accessions
ACCESSIONS=(
    SRR25058271
    SRR25058272
    SRR25058274
    SRR31095954
    SRR6071641
    SRR6071642
    SRR6071637
)

LOG="$BASE/conversion_status.tsv"

echo -e "Accession\tStatus\tDate" > "$LOG"

for ACC in "${ACCESSIONS[@]}"; do

    echo
    echo "========================================"
    echo "Processing: $ACC"
    echo "========================================"

    SRA_FILE="$SRA_DIR/$ACC/$ACC.sra"
    OUT1="$RAW_DIR/${ACC}_1.fastq.gz"
    OUT2="$RAW_DIR/${ACC}_2.fastq.gz"

    # Check whether SRA file exists
    if [[ ! -s "$SRA_FILE" ]]; then
        echo "ERROR: SRA file missing: $SRA_FILE"
        echo -e "$ACC\tSRA_MISSING\t$(date)" >> "$LOG"
        continue
    fi

    # Skip if both compressed FASTQ files already exist and are valid
    if [[ -s "$OUT1" && -s "$OUT2" ]]; then
        if gzip -t "$OUT1" "$OUT2"; then
            echo "Already converted and compressed. Skipping $ACC"
            echo -e "$ACC\tSKIPPED_ALREADY_COMPLETE\t$(date)" >> "$LOG"
            continue
        fi
    fi

    # Avoid overwriting incomplete or existing output files
    if [[ -e "$OUT1" || -e "$OUT2" ]]; then
        echo "WARNING: Existing partial or invalid output detected."
        echo "Please inspect these files before rerunning."
        echo -e "$ACC\tEXISTING_OUTPUT_NEEDS_CHECK\t$(date)" >> "$LOG"
        continue
    fi

    ACC_WORK="$WORK_DIR/$ACC"
    ACC_TMP="$TMP_DIR/$ACC"

    mkdir -p "$ACC_WORK" "$ACC_TMP"

    echo "Starting fasterq-dump for $ACC"

    fasterq-dump "$SRA_FILE" \
        --split-files \
        --threads 8 \
        --temp "$ACC_TMP" \
        --outdir "$ACC_WORK"

    if [[ $? -ne 0 ]]; then
        echo "ERROR: fasterq-dump failed for $ACC"
        echo -e "$ACC\tFASTERQ_FAILED\t$(date)" >> "$LOG"
        continue
    fi

    # Confirm paired-end FASTQ files were generated
    if [[ ! -s "$ACC_WORK/${ACC}_1.fastq" ||
          ! -s "$ACC_WORK/${ACC}_2.fastq" ]]; then
        echo "ERROR: Expected paired FASTQ files were not found."
        echo -e "$ACC\tFASTQ_FILES_MISSING\t$(date)" >> "$LOG"
        continue
    fi

    echo "Compressing FASTQ files for $ACC"

    gzip -1 "$ACC_WORK/${ACC}_1.fastq" \
            "$ACC_WORK/${ACC}_2.fastq"

    if [[ $? -ne 0 ]]; then
        echo "ERROR: gzip failed for $ACC"
        echo -e "$ACC\tGZIP_FAILED\t$(date)" >> "$LOG"
        continue
    fi

    # Test compressed files
    if gzip -t "$ACC_WORK/${ACC}_1.fastq.gz" \
               "$ACC_WORK/${ACC}_2.fastq.gz"; then

        mv "$ACC_WORK/${ACC}_1.fastq.gz" "$RAW_DIR/"
        mv "$ACC_WORK/${ACC}_2.fastq.gz" "$RAW_DIR/"

        echo "SUCCESS: $ACC"
        echo -e "$ACC\tSUCCESS\t$(date)" >> "$LOG"

        # Remove only temporary conversion files after successful transfer
        rmdir "$ACC_WORK" 2>/dev/null || true
        rm -rf "$ACC_TMP"

    else
        echo "ERROR: gzip integrity test failed for $ACC"
        echo -e "$ACC\tGZIP_TEST_FAILED\t$(date)" >> "$LOG"
        continue
    fi

done

echo
echo "========================================"
echo "All accession jobs have been attempted."
echo "Check the status log:"
echo "$LOG"
echo "========================================"
EOF



$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$


