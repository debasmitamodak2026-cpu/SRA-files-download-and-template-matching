#!/bin/bash

# Activate SRA Toolkit environment
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate sra_tools

# Directories
BASE="/home/debasmita/workspace/Canidae_Felidae_Project/felids/sra/sra_downloads"
ACCESSION_FILE="$BASE/accessions/sra.txt"
OUTDIR="$BASE/sra_files"
LOGDIR="$BASE/logs"

mkdir -p "$OUTDIR" "$LOGDIR"

# Check accession file
if [[ ! -s "$ACCESSION_FILE" ]]; then
    echo "ERROR: Accession file is missing or empty."
    exit 1
fi

# Download a maximum of 5 accessions simultaneously
echo "Starting SRA downloads..."
echo "Parallel downloads: 5"
echo "Output directory: $OUTDIR"

cat "$ACCESSION_FILE" | \
grep -v '^[[:space:]]*$' | \
xargs -P 8 -I {} bash -c '
    accession="$1"

    echo "Starting: $accession"

    prefetch "$accession" \
        --max-size unlimited \
        --output-directory "'"$OUTDIR"'" \
        --resume yes \
        > "'"$LOGDIR"'/${accession}.log" 2>&1

    if [[ $? -eq 0 ]]; then
        echo "SUCCESS: $accession"
    else
        echo "FAILED: $accession"
    fi
' _ {}

echo "All download jobs have finished."


# Then ctrl+o, release, Enter, release, ctrl+x - to save the changes

# Made the script exicutable
$ chmod +x download_sra.sh

# Run the script
$ ./download_sra.sh


