    5. Create the download script
    -----------------------------
    # The script was created with the following command and contents:




    cat > download_canid_genomes.sh <<'EOF'
    #!/usr/bin/env bash
    
    set -u
    
    INPUT="14_canids_genome_assembly.txt"
    MASTER_LOG="download_master.log"
    CONSOLE_LOG="download_console.log"
    STATUS="download_status.tsv"
    
    # Verify input and required command
    if [[ ! -f "$INPUT" ]]; then
        echo "ERROR: Input file not found: $INPUT"
        exit 1
    fi
    
    if ! command -v datasets >/dev/null 2>&1; then
        echo "ERROR: NCBI Datasets CLI not found."
        echo "Load your Anaconda module and activate the felid_download environment."
        exit 1
    fi
    
    printf 'Species_ID\tAccession\tStatus\tDate\n' > "$STATUS"
    echo "Started: $(date)" | tee -a "$MASTER_LOG"
    
    # Read the tab-separated file; skip its header
    tail -n +2 "$INPUT" | while read -r species accession rest; do
        [[ -z "${species:-}" || -z "${accession:-}" ]] && continue
    
        species_dir="$species"
        fasta_dir="$species_dir/ncbi_dataset"
        zip_file="$species_dir/${accession}_dataset.zip"
    
        mkdir -p "$species_dir"
    
        # Skip downloading if a non-empty genomic FASTA already exists
        existing_fasta=$(find "$fasta_dir" -type f -name '*_genomic.fna' \
            -size +0c -print -quit 2>/dev/null || true)
    
        if [[ -n "$existing_fasta" ]]; then
            status="SKIPPED_EXISTING"
            echo "[$(date)] $species $accession: FASTA already exists: $existing_fasta" \
                | tee -a "$MASTER_LOG"
        else
            echo "[$(date)] Starting $species : $accession" | tee -a "$MASTER_LOG"
    
            if datasets download genome accession "$accession" \
                --include genome --filename "$zip_file" \
                >> "$CONSOLE_LOG" 2>&1; then
    
                if unzip -oq "$zip_file" -d "$species_dir" \
                    >> "$CONSOLE_LOG" 2>&1; then
    
                    existing_fasta=$(find "$fasta_dir" -type f -name '*_genomic.fna' \
                        -size +0c -print -quit 2>/dev/null || true)
    
                    if [[ -n "$existing_fasta" ]]; then
                        status="SUCCESS"
                        rm -f "$zip_file"
                        echo "[$(date)] SUCCESS: $species $accession -> $existing_fasta" \
                            | tee -a "$MASTER_LOG"
                    else
                        status="NO_VALID_FASTA"
                        echo "[$(date)] ERROR: No non-empty genomic FASTA for $species" \
                            | tee -a "$MASTER_LOG"
                    fi
                else
                    status="EXTRACTION_FAILED"
                    echo "[$(date)] ERROR: Extraction failed for $species" \
                        | tee -a "$MASTER_LOG"
                fi
            else
                status="DOWNLOAD_FAILED"
                echo "[$(date)] ERROR: Download failed for $species ($accession)" \
                    | tee -a "$MASTER_LOG"
            fi
        fi
    
        printf '%s\t%s\t%s\t%s\n' "$species" "$accession" "$status" "$(date)" \
            >> "$STATUS"
    
    done
    
    echo "Finished: $(date)" | tee -a "$MASTER_LOG"
    echo "Status report: $STATUS"
    EOF
    
    chmod +x download_canid_genomes.sh



