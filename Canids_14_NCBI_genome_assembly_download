    7. Create the download script
    -----------------------------
    # The script was created with the following command and contents:



    cd /home/debasmita/workspace/Canidae_Felidae_Project/felids/genome_assemblies

    cat > download_felid_genomes.sh <<'EOF'
    #!/usr/bin/env bash

    set -u
    set -o pipefail

    BASE_DIR="/home/debasmita/workspace/Canidae_Felidae_Project/felids/genome_assemblies"
    INPUT_FILE="$BASE_DIR/24_felids_genome_assembly.txt"
    LOG_FILE="$BASE_DIR/download_master.log"
    STATUS_FILE="$BASE_DIR/download_status.tsv"

    if ! command -v datasets >/dev/null 2>&1; then
        echo "ERROR: The NCBI datasets command is unavailable."
        exit 1
    fi

    if [[ ! -f "$INPUT_FILE" ]]; then
        echo "ERROR: Input file not found: $INPUT_FILE"
        exit 1
    fi

    touch "$LOG_FILE"
    touch "$STATUS_FILE"

    while IFS=$'\t' read -r species_id accession rest || [[ -n "${species_id:-}" ]]; do
        species_id="${species_id//$'\r'/}"
        accession="${accession//$'\r'/}"
        species_id="${species_id// /}"
        accession="${accession// /}"

        [[ -z "$species_id" || -z "$accession" ]] && continue

        if [[ ! "$species_id" =~ ^FEL[0-9]{3}$ || ! "$accession" =~ ^GC[AF]_[0-9]+\.[0-9]+$ ]]; then
            echo "Skipping header or invalid row: $species_id $accession" | tee -a "$LOG_FILE"
            continue
        fi

        SPECIES_DIR="$BASE_DIR/$species_id"
        ZIP_FILE="$SPECIES_DIR/${accession}_dataset.zip"
        mkdir -p "$SPECIES_DIR"

        # Skip an assembly if its genomic FASTA is already present.
        EXISTING_FASTA=$(find "$SPECIES_DIR/ncbi_dataset" -type f -name '*_genomic.fna' -print -quit 2>/dev/null || true)

        if [[ -n "$EXISTING_FASTA" ]]; then
            echo "[$(date)] $species_id already has a genome FASTA; skipping." | tee -a "$LOG_FILE"
            printf "%s\t%s\tALREADY_PRESENT\t%s\n" "$species_id" "$accession" "$(date)" >> "$STATUS_FILE"
            continue
        fi

        echo "[$(date)] Starting $species_id : $accession" | tee -a "$LOG_FILE"

        if datasets download genome accession "$accession" --include genome --filename "$ZIP_FILE" 2>&1 | tee -a "$LOG_FILE"; then
            if unzip -oq "$ZIP_FILE" -d "$SPECIES_DIR" 2>&1 | tee -a "$LOG_FILE"; then
                GENOME_FILE=$(find "$SPECIES_DIR/ncbi_dataset" -type f -name '*_genomic.fna' -print -quit 2>/dev/null || true)

                if [[ -n "$GENOME_FILE" ]]; then
                    rm -f "$ZIP_FILE"
                    echo "[$(date)] SUCCESS: $species_id -> $GENOME_FILE" | tee -a "$LOG_FILE"
                    printf "%s\t%s\tSUCCESS\t%s\n" "$species_id" "$accession" "$(date)" >> "$STATUS_FILE"
                else
                    echo "[$(date)] ERROR: No genomic FASTA found for $species_id" | tee -a "$LOG_FILE"
                    printf "%s\t%s\tNO_FASTA\t%s\n" "$species_id" "$accession" "$(date)" >> "$STATUS_FILE"
                fi
            else
                echo "[$(date)] ERROR: Extraction failed for $species_id" | tee -a "$LOG_FILE"
                printf "%s\t%s\tEXTRACTION_FAILED\t%s\n" "$species_id" "$accession" "$(date)" >> "$STATUS_FILE"
            fi
        else
            echo "[$(date)] ERROR: Download failed for $species_id ($accession)" | tee -a "$LOG_FILE"
            printf "%s\t%s\tDOWNLOAD_FAILED\t%s\n" "$species_id" "$accession" "$(date)" >> "$STATUS_FILE"
            rm -f "$ZIP_FILE"
        fi

    done < "$INPUT_FILE"

    echo "[$(date)] Finished processing all entries." | tee -a "$LOG_FILE"
    EOF



    # Make the script executable:
    $ chmod +x download_felid_genomes.sh

